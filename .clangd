# Clangd configuration for Darwin/macOS development only
# Used for SSP emulator development and general C/C++ code editing
# Not needed for cross-compile targets (firmware, etc.)

CompileFlags:
  CompilationDatabase: None
  Add:
    - "-march=armv8.2-a"
    - "-rdynamic"
    - "-DFIRMWARE_VERSION=\"dev\""
    - "-DBUILD_PROFILE=debug"
    # macOS editor fallback when no compile_commands.json is present
    - "-DPERCUSSA_PLATFORM_HOST_SDL"
    - "-DTARGET_SSP"
    # Project includes (absolute - prioritized for full definitions)
    - "-I/Users/kodiak/projects/er-301"
    - "-I/Users/kodiak/projects/er-301/od"
    - "-I/Users/kodiak/projects/er-301/hal"
    # Project includes (relative)
    - "-I."
    - "-I./percussa"
    - "-I./arch/darwin"
    - "-I./libs/lua54"
    - "-I./libs/lodepng"
    - "-I./libs/miniz"
    - "-I./libs/SDL_FontCache"
    - "-I./libs/rtaudio"
    - "-I./emu"
    # Additional project includes (absolute)
    - "-I/Users/kodiak/projects/er-301/libs/darwin"
    - "-I/Users/kodiak/projects/er-301/libs/lua54"
    - "-I/Users/kodiak/projects/er-301/libs/lodepng"
    - "-I/Users/kodiak/projects/er-301/libs/miniz"
    - "-I/Users/kodiak/projects/er-301/libs/SDL_FontCache"
    - "-I/Users/kodiak/projects/er-301/libs/rtaudio"
    # Brew dependencies (macOS)
    - "-I/opt/homebrew/opt/sdl2/include"
    - "-I/opt/homebrew/opt/sdl2/include/SDL2"
    - "-I/opt/homebrew/opt/sdl2_ttf/include"
    - "-I/opt/homebrew/opt/fftw/include"
  Compiler: clang++

InlayHints:
  Enabled: true

Hover:
  ShowAKA: true
